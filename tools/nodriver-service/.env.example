# Generate a fresh local token; do not commit the value.
RENDER_API_TOKEN=
ALLOWED_DOMAINS=worten.pt
PORT=8080
RENDER_TIMEOUT_SECONDS=45
BROWSER_START_TIMEOUT_SECONDS=15
NAVIGATION_TIMEOUT_SECONDS=25
SETTLE_SECONDS=2
MAX_CONTENT_BYTES=2097152
# Set CHROME_BIN to an installed Chromium/Chrome executable for local Windows runs.
CHROME_BIN=
